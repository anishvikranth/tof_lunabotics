<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cac_rover_ign">
    <gazebo>
        <plugin
        filename="ignition-gazebo-joint-state-publisher-system"
        name="ignition::gazebo::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        </plugin>
    </gazebo>

  <!-- Differential Drive Controller -->
  <!-- Allows driving the rover via /cmd_vel -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">
      <!-- Front & Rear Left Wheels -->
      <left_joint>front_left_wheel_link_joint</left_joint>
      <left_joint>back_left_wheel_link_joint</left_joint>
      
      <!-- Front & Rear Right Wheels -->
      <right_joint>front_right_wheel_link_joint</right_joint>
      <right_joint>back_right_wheel_link_joint</right_joint>

      <wheel_separation>0.4275</wheel_separation> 
      <wheel_radius>0.1</wheel_radius>

      <topic>/motion</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>
    </plugin>
  </gazebo>

    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia 
                ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
                izz="${(1/12) * mass * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia 
                ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="aluminium">
        <material name="aluminium">
            <color rgba="0.8 0.8 0.75 1.0"/>
        </material>
    </xacro:macro>

    <xacro:macro name="polycarbonate">
        <material name="polycarbonate">
            <color rgba="0.8 0.85 0.9 0.4"/>
        </material>
    </xacro:macro>

    <xacro:macro name="black_pla">
        <material name="black_pla">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </xacro:macro>

    <xacro:macro name="gray_tpu">
        <material name="gray_tpu">
            <color rgba="0.255 0.255 0.255 1.0"/>
        </material>
    </xacro:macro>
    <!-- Base Footprint Link -->
    <link name="base_footprint" />

    <!-- Base Footprint Joint -->
     <joint name="base_link_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0085" rpy="0.0 0.0 0.0"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>
     </joint>

    <!-- Base (Chassis) Link -->
    <link name="base_link">
        <xacro:inertial_box mass="2.0" x="0.55" y="0.31" z="0.017">
            <origin xyz="0.0 0.0 -0.0085" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_box>
        <visual name="base_link_visual">
            <origin xyz="0.0 0.0 -0.0085" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.55 0.31 0.017"/>
            </geometry>
            <xacro:aluminium />
        </visual>
        <collision>
            <origin xyz="0.0 0.0 -0.0085" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.55 0.31 0.017"/>
            </geometry>
        </collision>
    </link>

    <!-- Elecbox joint -->
    <joint name="elecbox_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="elecbox_link"/>
    </joint>

    <!-- Elecbox Link -->
    <link name="elecbox_link">
        <xacro:inertial_box mass="1.1" x="0.29" y="0.3" z="0.26">
            <origin xyz="0.0 0.0 0.13" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_box>
        <visual name="elecbox_link_visual">
            <origin xyz="0.0 0.0 0.13" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.29 0.3 0.26"/>
            </geometry>
            <xacro:polycarbonate />
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.13" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.29 0.3 0.26"/>
            </geometry>
        </collision>
    </link>

    <!-- Shoulder Block Links -->
    <xacro:macro name="shoulder_block_link" params="direction">
        <xacro:property name="rotation" value="${0.0 if direction == 'front' else pi}" />
        <link name="${direction}_shoulder_block_link">
            <xacro:inertial_box mass="1.9" x="0.091" y="0.063" z="0.126">
                <origin xyz="0.0 0.0 0.063" rpy="0.0 0.0 0.0"/>
            </xacro:inertial_box>
            <visual name="${direction}_shoulder_box_link_visual">
                <origin xyz="0.0 0.0 0.063" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.091 0.063 0.126"/>
                </geometry>
                <xacro:aluminium />
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.063" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.091 0.063 0.126"/>
                </geometry>
            </collision>
        </link>

        <joint name="${direction}_shoulder_block_link_joint" type="fixed">
            <xacro:property name="x_val" value="${0.2295 if direction == 'front' else -0.2295}" />
            <xacro:property name="offset" value="${-0.0585 if direction == 'front' else 0.0585}"/>
            <origin xyz="${x_val} ${offset} 0.0" rpy="0.0 0.0 ${rotation}"/>
            <parent link="base_link"/>
            <child link="${direction}_shoulder_block_link"/>  
        </joint>
    </xacro:macro>

    <xacro:shoulder_block_link direction="front" />
    <xacro:shoulder_block_link direction="back" />

    <!-- Shoulder Links -->
    <xacro:macro name="shoulder_link" params="direction">  
        <link name="${direction}_shoulder_link">
            <xacro:inertial_cylinder mass="0.3" length="0.29" radius="0.0095">
                <origin xyz="0.0 0.0 0.145" rpy="0.0 0.0 0.0"/>
            </xacro:inertial_cylinder> 
            <visual name="${direction}_shoulder_link_visual">
                <origin xyz="0.0 0.0 0.145" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.0095" length="0.29"/>
                </geometry>
                <xacro:aluminium />
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.145" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.0095" length="0.29"/>
                </geometry>
            </collision>
        </link>

        <joint name="${direction}_shoulder_link_joint" type="revolute">
            <origin xyz="0.0 0.06 0.043" rpy="0.0 0.0 0.0"/>
            <parent link="${direction}_shoulder_block_link"/>
            <child link="${direction}_shoulder_link"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit lower="0.0" upper="${3 * pi / 4}" effort="200.0" velocity="1.0"/>
            <dynamics damping="1.0" friction="20.0"/>
        </joint>
    </xacro:macro>
    
    <xacro:shoulder_link direction="front" />
    <xacro:shoulder_link direction="back"/>

    <!-- Drum Block Link -->
    <xacro:macro name="drum_block_link" params="direction">
        <link name="${direction}_drum_block_link">
            <xacro:inertial_box mass="1.5" x="0.13" y="0.0629" z="0.106">
                <origin xyz="0.065 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </xacro:inertial_box>
            <visual name="${direction}_drum_block_link_visual">
                <origin xyz="0.065 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.13 0.0629 0.106"/>
                </geometry>
                <xacro:black_pla />
            </visual>
            <collision>
                <origin xyz="0.065 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <box size="0.13 0.0629 0.106"/>
                </geometry>
            </collision>
        </link>

        <joint name="${direction}_drum_block_link_joint" type="fixed">
            <origin xyz="0.0 0.0 0.29" rpy="0.0 0.0 0.0"/>
            <parent link="${direction}_shoulder_link"/>
            <child link="${direction}_drum_block_link"/>
        </joint>
    </xacro:macro>

    <xacro:drum_block_link direction="front" />
    <xacro:drum_block_link direction="back" />

    <!-- Drum Links -->
    <xacro:macro name="drum_link" params="direction side">
        <link name="${direction}_${side}_drum_link">
            <xacro:inertial_cylinder mass="0.8" length="0.16" radius="0.089">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </xacro:inertial_cylinder> 
            <visual name="drum_link_visual">
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.089" length="0.16"/>
                </geometry>
                <xacro:aluminium />
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.089" length="0.16"/>
                </geometry>
            </collision>
        </link>

        <joint name="${direction}_${side}_drum_link_joint" type="continuous">
            <xacro:property name="align" value="${pi / 2 if side == 'left' else -pi / 2}" />
            <xacro:property name="y_offset" value="${0.16845 if side == 'left' else -0.16845}" />
            <origin xyz="0.065 ${y_offset} 0.0" rpy="${align} 0.0 0.0"/>
            <parent link="${direction}_drum_block_link"/>
            <child link="${direction}_${side}_drum_link"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit effort="10.0" velocity="1.0"/>
        </joint>
    </xacro:macro>

    <xacro:drum_link direction="front" side="left" />
    <xacro:drum_link direction="front" side="right" />
    <xacro:drum_link direction="back" side="left" />
    <xacro:drum_link direction="back" side="right" />

    <!-- Wheel Links with Integrated Compliant Spoke Deformation -->
    <xacro:macro name="wheel_link" params="direction side">
        
        <!-- 1. Dummy Axle Link (Connects spring joint to rotation joint) -->
        <link name="${direction}_${side}_wheel_axle_link">
            <xacro:inertial_box mass="0.01" x="0.01" y="0.01" z="0.01">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>

        <!-- 2. Virtual Compliant Joint (Simulates 2-3 cm TPU spoke compression) -->
        <joint name="${direction}_${side}_wheel_compliance_joint" type="prismatic">
            <xacro:property name="x_off" value="${0.210 if direction == 'front' else -0.210}" />
            <xacro:property name="y_off" value="${0.16375 if side == 'left' else -0.16375}" />
            
            <origin xyz="${x_off} ${y_off} -0.063238" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${direction}_${side}_wheel_axle_link"/>
            
            <!-- Moves vertically along Z-axis -->
            <axis xyz="0.0 0.0 1.0"/>
            <!-- Limits travel: 0.0 is uncompressed, -0.03 is 3 cm max squish -->
            <limit lower="-0.03" upper="0.0" effort="500.0" velocity="2.0"/>
            
            <!-- Dynamic Stiffness & Damping for TPU spokes -->
            <dynamics spring_stiffness="2940.0" spring_reference="0.0" damping="80.0"/>
        </joint>

        <!-- 3. Physical Wheel Link -->
        <link name="${direction}_${side}_wheel_link">
            <xacro:inertial_cylinder mass="2.5" radius="0.1" length="0.1">
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
            </xacro:inertial_cylinder>
            <visual name="${direction}_${side}_wheel_visual">
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.1" length="0.1"/>
                </geometry>
                <xacro:gray_tpu />
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.1" length="0.1"/>
                </geometry>
            </collision>
        </link>

        <!-- 4. Wheel Rotation Joint (Attached to Axle Link instead of Base Link) -->
        <joint name="${direction}_${side}_wheel_link_joint" type="continuous">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="${direction}_${side}_wheel_axle_link"/>
            <child link="${direction}_${side}_wheel_link"/>
            
            <axis xyz="0.0 1.0 0.0"/>
            <limit effort="50.0" velocity="10.0"/>
        </joint>

        <!-- Dynamic Surface Contact -->
        <gazebo reference="${direction}_${side}_wheel_link">
            <mu1>1.0</mu1>
            <mu2>0.1</mu2>
            <fdir1>1 0 0</fdir1>
            <kp>100000.0</kp> <!-- Stiffer surface since spring joint handles compliance -->
            <kd>100.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_link direction="front" side="left" />
    <xacro:wheel_link direction="front" side="right" />
    <xacro:wheel_link direction="back" side="left" />
    <xacro:wheel_link direction="back" side="right" />

    <!-- ZED Camera Link -->
    <link name="zed_camera_link">
        <xacro:inertial_box mass="0.166" y="0.17525" z="0.03025" x="0.0431" >
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </xacro:inertial_box>
        <visual name="zed_camera_link_visual">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.0431 0.17525 0.03025"/>
            </geometry>
            <xacro:black_pla />
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.0431 0.17525 0.03025"/>
            </geometry>
        </collision>
    </link>

    <joint name="zed_camera_link_joint" type="fixed">
        <origin xyz="0.0 0.06 0.5" rpy="0.0 0.0 0.0 "/>
        <parent link="front_shoulder_block_link"/>
        <child link="zed_camera_link"/>
    </joint>

    <!-- ZED Camera Optical Frame -->
    <link name="zed_camera_optical_frame"/>

    <!-- Dedicated frame for Gazebo Sim RGBD Point Cloud -->
    <link name="zed_camera_gz_pointcloud_frame"/>

    <joint name="zed_camera_gz_pointcloud_joint" type="fixed">
        <!-- Identity rotation (0 0 0) keeps coordinates aligned with base_link -->
        <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 ${pi/2}"/>
        <parent link="zed_camera_link"/>
        <child link="zed_camera_gz_pointcloud_frame"/>
    </joint>

    <joint name="zed_camera_optical_joint" type="fixed">
        <origin xyz="0.06 0.0 0.015125" rpy="${-pi/2} 0.0 ${-pi/2}"/>
        <parent link="zed_camera_link"/>
        <child link="zed_camera_optical_frame"/>
    </joint>

    <gazebo reference="elecbox_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <topic>/imu/data</topic>
            <pose>0 0 0.075 0 0 0</pose>
        </sensor>
    </gazebo>

    <gazebo reference="zed_camera_link">
        <sensor name="zed_camera" type="rgbd_camera">
            <gz_frame_id>zed_camera_link</gz_frame_id>
            <visualize>false</visualize>
            <camera name="zed_camera">
                <optical_frame_id>zed_camera_link</optical_frame_id>
                <horizontal_fov>1.91986</horizontal_fov> <!-- ~110 degree horizontal FOV -->
                <image>
                    <width>1280</width>
                    <height>720</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.3</near>
                    <far>20.0</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <topic>/zed/zed_node</topic>
        </sensor>
    </gazebo>

    <!-- ZED Internal High-Precision IMU Sensor -->
    <gazebo reference="zed_camera_link">
        <sensor name="zed_imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>200</update_rate>
            <visualize>false</visualize>
            <topic>/zed/zed_node/imu/data</topic>
            <gz_frame_id>zed_camera_link</gz_frame_id>
            
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0009</stddev>
                            <bias_mean>0.0</bias_mean>
                            <bias_stddev>0.00001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0009</stddev>
                            <bias_mean>0.0</bias_mean>
                            <bias_stddev>0.00001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0009</stddev>
                            <bias_mean>0.0</bias_mean>
                            <bias_stddev>0.00001</bias_stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.003</stddev>
                            <bias_mean>0.0</bias_mean>
                            <bias_stddev>0.0001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.003</stddev>
                            <bias_mean>0.0</bias_mean>
                            <bias_stddev>0.0001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.003</stddev>
                            <bias_mean>0.0</bias_mean>
                            <bias_stddev>0.0001</bias_stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <gazebo reference="zed_camera_link_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <!-- LiDAR Link -->
<link name="lidar_link">
    <xacro:inertial_cylinder mass="0.125" length="0.05" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <material name="black_pla"/>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
    </collision>
</link>

<!-- LiDAR Joint -->
<joint name="lidar_joint" type="fixed">
    <origin xyz="0.1 0 0.3" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
</joint>

<!-- Gazebo Sensor Plugin -->
<gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <resolution>1.0</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>10.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
    </sensor>
</gazebo>
</robot>
