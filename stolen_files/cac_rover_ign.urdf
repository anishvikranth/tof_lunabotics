    </inertial>
  </link>
  <!-- 2. Virtual Compliant Joint (Simulates 2-3 cm TPU spoke compression) -->
  <joint name="back_left_wheel_compliance_joint" type="prismatic">
    <origin rpy="0.0 0.0 0.0" xyz="-0.21 0.16375 -0.063238"/>
    <parent link="base_link"/>
    <child link="back_left_wheel_axle_link"/>
    <!-- Moves vertically along Z-axis -->
    <axis xyz="0.0 0.0 1.0"/>
    <!-- Limits travel: 0.0 is uncompressed, -0.03 is 3 cm max squish -->
    <limit effort="500.0" lower="-0.03" upper="0.0" velocity="2.0"/>
    <!-- Dynamic Stiffness & Damping for TPU spokes -->
    <dynamics damping="80.0" spring_reference="0.0" spring_stiffness="2940.0"/>
  </joint>
  <!-- 3. Physical Wheel Link -->
  <link name="back_left_wheel_link">
    <inertial>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="2.5"/>
      <inertia ixx="0.008333333333333335" ixy="0.0" ixz="0.0" iyy="0.008333333333333335" iyz="0.0" izz="0.012500000000000002"/>
    </inertial>
    <visual name="back_left_wheel_visual">
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="gray_tpu">
        <color rgba="0.255 0.255 0.255 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
    </collision>
  </link>
  <!-- 4. Wheel Rotation Joint (Attached to Axle Link instead of Base Link) -->
  <joint name="back_left_wheel_link_joint" type="continuous">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <parent link="back_left_wheel_axle_link"/>
    <child link="back_left_wheel_link"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50.0" velocity="10.0"/>
  </joint>
  <!-- Dynamic Surface Contact -->
  <gazebo reference="back_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>100000.0</kp>
    <!-- Stiffer surface since spring joint handles compliance -->
    <kd>100.0</kd>
  </gazebo>
  <!-- 1. Dummy Axle Link (Connects spring joint to rotation joint) -->
  <link name="back_right_wheel_axle_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1.6666666666666668e-07" ixy="0.0" ixz="0.0" iyy="1.6666666666666668e-07" iyz="0.0" izz="1.6666666666666668e-07"/>
    </inertial>
  </link>
  <!-- 2. Virtual Compliant Joint (Simulates 2-3 cm TPU spoke compression) -->
  <joint name="back_right_wheel_compliance_joint" type="prismatic">
    <origin rpy="0.0 0.0 0.0" xyz="-0.21 -0.16375 -0.063238"/>
    <parent link="base_link"/>
    <child link="back_right_wheel_axle_link"/>
    <!-- Moves vertically along Z-axis -->
    <axis xyz="0.0 0.0 1.0"/>
    <!-- Limits travel: 0.0 is uncompressed, -0.03 is 3 cm max squish -->
    <limit effort="500.0" lower="-0.03" upper="0.0" velocity="2.0"/>
    <!-- Dynamic Stiffness & Damping for TPU spokes -->
    <dynamics damping="80.0" spring_reference="0.0" spring_stiffness="2940.0"/>
  </joint>
  <!-- 3. Physical Wheel Link -->
  <link name="back_right_wheel_link">
    <inertial>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="2.5"/>
      <inertia ixx="0.008333333333333335" ixy="0.0" ixz="0.0" iyy="0.008333333333333335" iyz="0.0" izz="0.012500000000000002"/>
    </inertial>
    <visual name="back_right_wheel_visual">
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="gray_tpu">
        <color rgba="0.255 0.255 0.255 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
    </collision>
  </link>
  <!-- 4. Wheel Rotation Joint (Attached to Axle Link instead of Base Link) -->
  <joint name="back_right_wheel_link_joint" type="continuous">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <parent link="back_right_wheel_axle_link"/>
    <child link="back_right_wheel_link"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50.0" velocity="10.0"/>
  </joint>
  <!-- Dynamic Surface Contact -->
  <gazebo reference="back_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>0.1</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>100000.0</kp>
    <!-- Stiffer surface since spring joint handles compliance -->
    <kd>100.0</kd>
  </gazebo>
  <!-- ZED Camera Link -->
  <link name="zed_camera_link">
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="0.166"/>
      <inertia ixx="0.00043751547916666655" ixy="0.0" ixz="0.0" iyy="3.8355302916666666e-05" iyz="0.0" izz="0.0004505540529166666"/>
    </inertial>
    <visual name="zed_camera_link_visual">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.0431 0.17525 0.03025"/>
      </geometry>
      <material name="black_pla">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.0431 0.17525 0.03025"/>
      </geometry>
    </collision>
  </link>
  <joint name="zed_camera_link_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0 " xyz="0.0 0.06 0.5"/>
    <parent link="front_shoulder_block_link"/>
    <child link="zed_camera_link"/>
  </joint>
  <!-- ZED Camera Optical Frame -->
  <link name="zed_camera_optical_frame"/>
  <!-- Dedicated frame for Gazebo Sim RGBD Point Cloud -->
  <link name="zed_camera_gz_pointcloud_frame"/>
  <joint name="zed_camera_gz_pointcloud_joint" type="fixed">
    <!-- Identity rotation (0 0 0) keeps coordinates aligned with base_link -->
    <origin rpy="1.5707963267948966 0.0 1.5707963267948966" xyz="0.0 0.0 0.0"/>
    <parent link="zed_camera_link"/>
    <child link="zed_camera_gz_pointcloud_frame"/>
  </joint>
  <joint name="zed_camera_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0.06 0.0 0.015125"/>
    <parent link="zed_camera_link"/>
    <child link="zed_camera_optical_frame"/>
  </joint>
  <gazebo reference="elecbox_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu/data</topic>
      <pose>0 0 0.075 0 0 0</pose>
    </sensor>
  </gazebo>
  <gazebo reference="zed_camera_link">
    <sensor name="zed_camera" type="rgbd_camera">
      <gz_frame_id>zed_camera_link</gz_frame_id>
      <visualize>false</visualize>
      <camera name="zed_camera">
        <optical_frame_id>zed_camera_link</optical_frame_id>
        <horizontal_fov>1.91986</horizontal_fov>
        <!-- ~110 degree horizontal FOV -->
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>20.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <topic>/zed/zed_node</topic>
    </sensor>
  </gazebo>
  <!-- ZED Internal High-Precision IMU Sensor -->
  <gazebo reference="zed_camera_link">
    <sensor name="zed_imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <topic>/zed/zed_node/imu/data</topic>
      <gz_frame_id>zed_camera_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0009</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0009</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0009</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00001</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.003</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.003</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.003</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.0001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="zed_camera_link_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
</robot>
