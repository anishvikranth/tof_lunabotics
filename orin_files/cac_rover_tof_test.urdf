      <geometry>
        <mesh filename="file:///opt/ros/humble/share/zed_msgs/meshes/zed2i.stl"/>
      </geometry>
      <material name="zed2i_mat"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.01 0 0.0"/>
      <geometry>
        <mesh filename="file:///opt/ros/humble/share/zed_msgs/meshes/zed2i.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="zed_camera_center_joint" type="fixed">
    <parent link="zed_camera_link"/>
    <child link="zed_camera_center"/>
    <origin rpy="0 0.0 0" xyz="0 0 0.015"/>
  </joint>
  <!-- Left Camera -->
  <link name="zed_left_camera_frame">
  </link>
  <joint name="zed_left_camera_joint" type="fixed">
    <parent link="zed_camera_center"/>
    <child link="zed_left_camera_frame"/>
    <origin rpy="0 0 0" xyz="-0.01 0.06 0"/>
  </joint>
  <link name="zed_left_camera_optical_frame"/>
  <joint name="zed_left_camera_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="zed_left_camera_frame"/>
    <child link="zed_left_camera_optical_frame"/>
  </joint>
  <!-- Right Camera -->
  <link name="zed_right_camera_frame">
  </link>
  <joint name="zed_right_camera_joint" type="fixed">
    <parent link="zed_camera_center"/>
    <child link="zed_right_camera_frame"/>
    <origin rpy="0 0 0" xyz="-0.01 -0.06 0"/>
  </joint>
  <link name="zed_right_camera_optical_frame"/>
  <joint name="zed_right_camera_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="zed_right_camera_frame"/>
    <child link="zed_right_camera_optical_frame"/>
  </joint>
  <!-- 2. Attach zed_camera_link to your rover chassis -->
  <joint name="elecbox_to_zed_camera" type="fixed">
    <parent link="elecbox_link"/>
    <child link="zed_camera_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.145 0.0 0.6"/>
  </joint>
  <!-- 3. ToF crater sensor (TFmini Plus) mounted on top of the ZED, tilted 33 deg down from horizontal (flat-ground reading d ~ 1.2 m).
       xyz = ToF lens position from the ZED's bottom tripod-screw hole (x forward, y left, z up, m):
       assumed centred over the ZED, z = ZED height 0.030 + ~0.011 to the lens centre. Adjust if measured.
       rpy pitch = downward tilt in radians (33 deg = 0.576; positive = down). -->
  <link name="tof"/>
  <joint name="zed_to_tof" type="fixed">
    <parent link="zed_camera_link"/>
    <child link="tof"/>
    <origin rpy="0.0 0.5759586531581288 0.0" xyz="0.0 0.0 0.041"/>
  </joint>
</robot>
